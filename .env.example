# =================================
# Incident Management System
# Environment Variables Example
# =================================

# ---------------------------------
# Security & Authentication
# ---------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
BCRYPT_SALT_ROUNDS=10

# ---------------------------------
# Database Configuration
# ---------------------------------
POSTGRES_PASSWORD=your-secure-postgres-password

# Auth Service Database
AUTH_DB_HOST=postgres-auth
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=ims_user
AUTH_DB_PASSWORD=${POSTGRES_PASSWORD}

# Incident Service Database
INCIDENT_DB_HOST=postgres-incidents
INCIDENT_DB_PORT=5432
INCIDENT_DB_NAME=incidents_db
INCIDENT_DB_USER=ims_user
INCIDENT_DB_PASSWORD=${POSTGRES_PASSWORD}

# Analytics Service Database (TimescaleDB)
ANALYTICS_DB_HOST=postgres-analytics
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics_db
ANALYTICS_DB_USER=ims_user
ANALYTICS_DB_PASSWORD=${POSTGRES_PASSWORD}

# Notification Service Database
NOTIFICATION_DB_HOST=postgres-notifications
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=notifications_db
NOTIFICATION_DB_USER=ims_user
NOTIFICATION_DB_PASSWORD=${POSTGRES_PASSWORD}

# File Storage Service Database
FILE_DB_HOST=postgres-files
FILE_DB_PORT=5432
FILE_DB_NAME=files_db
FILE_DB_USER=ims_user
FILE_DB_PASSWORD=${POSTGRES_PASSWORD}

# Workflow Service Database
WORKFLOW_DB_HOST=postgres-workflow
WORKFLOW_DB_PORT=5432
WORKFLOW_DB_NAME=workflow_db
WORKFLOW_DB_USER=ims_user
WORKFLOW_DB_PASSWORD=${POSTGRES_PASSWORD}

# Reporting Service Database
REPORTING_DB_HOST=postgres-reporting
REPORTING_DB_PORT=5432
REPORTING_DB_NAME=reporting_db
REPORTING_DB_USER=ims_user
REPORTING_DB_PASSWORD=${POSTGRES_PASSWORD}

# ---------------------------------
# Redis Configuration
# ---------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ---------------------------------
# RabbitMQ Configuration
# ---------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=ims_rabbitmq
RABBITMQ_DEFAULT_PASS=your-secure-rabbitmq-password
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672

# ---------------------------------
# Elasticsearch Configuration
# ---------------------------------
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-secure-elastic-password
ELASTIC_PASSWORD=${ELASTICSEARCH_PASSWORD}
ELASTICSEARCH_URL=http://${ELASTICSEARCH_USERNAME}:${ELASTICSEARCH_PASSWORD}@elasticsearch:9200

# ---------------------------------
# MinIO Configuration (S3-compatible storage)
# ---------------------------------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-secure-minio-password
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=incident-attachments

# ---------------------------------
# Email/SMTP Configuration
# ---------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@yourcompany.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Incident Management System <no-reply@yourcompany.com>

# ---------------------------------
# ClamAV Configuration (Virus Scanning)
# ---------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---------------------------------
# Monitoring Configuration
# ---------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password

# ---------------------------------
# Application Configuration
# ---------------------------------
NODE_ENV=production
LOG_LEVEL=info
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# API Gateway
API_GATEWAY_PORT=4000
API_GATEWAY_HOST=api-gateway

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------
# Rate Limiting
# ---------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------
# File Upload Limits
# ---------------------------------
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ---------------------------------
# Session Configuration
# ---------------------------------
SESSION_SECRET=your-super-secret-session-key-change-in-production-min-32-chars

# ---------------------------------
# Feature Flags
# ---------------------------------
ENABLE_ANONYMOUS_REPORTING=true
ENABLE_GUEST_REPORTING=true
ENABLE_FILE_UPLOADS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_VIRUS_SCANNING=true

# ---------------------------------
# Industry-Specific Settings
# ---------------------------------
# Comma-separated list of enabled industries
ENABLED_INDUSTRIES=mining,healthcare,retail

# Mining specific
MINING_MSHA_REPORTING_ENABLED=true
MINING_AUTO_NOTIFY_AUTHORITIES=false

# Healthcare specific
HEALTHCARE_HIPAA_MODE=true
HEALTHCARE_AUTOMATIC_DEIDENTIFICATION=true

# Retail specific
RETAIL_CUSTOMER_PII_PROTECTION=true
