# =======================================
# LOCAL DEVELOPMENT ENVIRONMENT
# =======================================
# This file contains safe defaults for local development.
# You can use this as-is without changing anything!
# =======================================

# ---------------------------------------
# Security (Safe defaults for local dev)
# ---------------------------------------
JWT_SECRET=local-dev-jwt-secret-not-for-production
POSTGRES_PASSWORD=devpassword
REDIS_PASSWORD=  # No password needed for local dev

# ---------------------------------------
# Database Settings
# ---------------------------------------
# These are automatically configured by Docker
# You don't need to change these unless you have conflicts

# ---------------------------------------
# MinIO (File Storage)
# ---------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------------------------------------
# Email (MailHog - catches all emails locally)
# ---------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
EMAIL_FROM=no-reply@localhost

# ---------------------------------------
# Application Settings
# ---------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------
# Feature Flags (all enabled for local dev)
# ---------------------------------------
ENABLE_ANONYMOUS_REPORTING=true
ENABLE_GUEST_REPORTING=true
ENABLE_FILE_UPLOADS=true
ENABLE_EMAIL_NOTIFICATIONS=true
